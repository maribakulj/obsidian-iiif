{
  "name": "obsidian-iiif",
  "version": "0.4.1",
  "description": "IIIF research companion for Obsidian — import manifests, clip regions, and link patrimonial digital objects into your vault.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings 'test/unit/**/*.test.ts'"
  },
  "keywords": [
    "obsidian",
    "iiif",
    "manifest",
    "digital-humanities",
    "glam"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.20.0",
    "obsidian": "^1.5.7",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
